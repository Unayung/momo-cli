class Net(Exception):
    pass


class Blocked(Net):
    pass


class Auth(Exception):
    pass


class ApiError(Exception):
    def __init__(self, msg, detail=None):
        super().__init__(msg)
        self.detail = detail


class Usage(ApiError):
    pass


# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code, "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else
               json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad("" if c is None else c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    if _w(text) <= n:
        return text
    out = ""
    for c in text:
        if _w(out + c) > n - 1:
            break
        out += c
    return out + "…"


def nt(v):
    return "" if v is None else f"NT${v:,.0f}"


def num(text):
    m = re.search(r"-?[\d,]+(?:\.\d+)?", text or "")
    return float(m.group(0).replace(",", "")) if m else None


# -------------------------------------------------------- SSL Context
def _ssl_context():
    """Create SSL context with relaxed cert checking for systems where momo's chain lacks SKI."""
    ctx = ssl.create_default_context()
    try:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    except Exception:
        pass
    return ctx


# -------------------------------------------------------- CDP (stdlib WS)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with --remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _cdp_json(path):
    try:
        ctx = _ssl_context()
        with urllib.request.urlopen(CDP + path, timeout=5, context=ctx) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). start Edge with --remote-debugging-port=9222")


def _set_cdp(cdp):
    global CDP
    if cdp:
        CDP = cdp


def edge_cookies():
    """All momo cookies of the CDP browser (browser-level, no tab needed)."""
    ver = _cdp_json("/json/version")
    b = WS(ver["webSocketDebuggerUrl"])
    try:
        cks = b.call("Storage.getCookies")["cookies"]
    finally:
        b.close()
    keep = [{"name": c["name"], "value": c["value"], "domain": c["domain"], "path": c.get("path", "/")}
            for c in cks if c["domain"].lstrip(".") == "momoshop.com.tw"
            or c["domain"].endswith(".momoshop.com.tw")]
    return keep, ver.get("User-Agent", DEFAULT_UA)


class Browser:
    """One background tab on momoshop.com.tw, closed on exit. Never focused; user tabs untouched."""

    def __init__(self, url=ORIGIN + "/", debug=False, wait=True):
        self.debug = debug
        self.ver = _cdp_json("/json/version")
        self.b = WS(self.ver["webSocketDebuggerUrl"])
        self.tid = self.b.call("Target.createTarget", url=url, background=True)["targetId"]
        try:
            tgt = next(x for x in _cdp_json("/json/list") if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
            if wait:
                self.wait_ready(urllib.parse.urlparse(url).netloc)
        except BaseException:
            self.close()
            raise

    def wait_ready(self, host, limit=30):
        t0 = time.time()
        while time.time() - t0 < limit:
            try:
                r = self.eval("location.host + '|' + document.readyState + '|' + document.title")
            except ApiError:
                r = None
            if r and r.startswith(host) and "|loading|" not in r and "Just a moment" not in r:
                return
            time.sleep(0.5)
        raise Net(f"{host} did not load in the background tab")

    def eval(self, expr):
        r = self.p.call("Runtime.evaluate", expression=expr, awaitPromise=True, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description")
                or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def fetch(self, method, url, body=None, headers=None):
        opts = {"method": method, "credentials": "include", "headers": headers or {}}
        if body is not None:
            opts["body"] = body
        js = ("fetch(%s,%s).then(async r=>({http:r.status,text:await r.text()}))"
              % (json.dumps(url), json.dumps(opts)))
        r = self.eval(js)
        return r["http"], r["text"]

    def close(self):
        try:
            self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()


# ------------------------------------------------------------------ state
def _keyring(op, secret=None):
    acct = "default"
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct,
                           "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=momo-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None,
                               capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def clean_cookie(val):
    if not val:
        return ""
    val = val.strip()
    if val.lower().startswith("cookie:"):
        val = val[7:].strip()
    return val


def cookie_list_to_header(cookies):
    return "; ".join(f"{c['name']}={c['value']}" for c in cookies if c.get("name"))


def cookie_header_to_list(header_str):
    out = []
    for part in (header_str or "").split(";"):
        if "=" in part:
            k, v = part.strip().split("=", 1)
            out.append({"name": k.strip(), "value": v.strip(), "domain": ".momoshop.com.tw"})
    return out


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("MOMO_COOKIE"):
        st["cookie"], st["source"] = clean_cookie(os.environ["MOMO_COOKIE"]), "env"
        st["cookies"] = cookie_header_to_list(st["cookie"])
    elif st.get("cookie_in_keyring"):
        raw = _keyring("get")
        if raw:
            try:
                data = json.loads(raw)
                st.update(data)
                st["source"] = "keyring"
            except Exception:
                st["cookie"], st["source"] = raw, "keyring"
                st["cookies"] = cookie_header_to_list(raw)
    elif st.get("cookie"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k != "source"}
    if out.get("cookie_in_keyring"):
        blob = json.dumps(out, ensure_ascii=False)
        _keyring("set", blob)
        out = {"cookie_in_keyring": True, "saved_at": out.get("saved_at")}
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def clear_state():
    st = load_state()
    if st.get("cookie_in_keyring"):
        try:
            _keyring("del")
        except Exception:
            pass
    try:
        os.remove(STATE_FILE)
    except FileNotFoundError:
        pass


# -------------------------------------------------------- HTTP Transport
def _request(method, url, data=None, headers=None, cookies_str=None, timeout=15):
    hdrs = {
        "User-Agent": UA,
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "zh-TW,zh;q=0.9,en-US;q=0.8,en;q=0.7",
    }
    if headers:
        hdrs.update(headers)
    if cookies_str:
        hdrs["Cookie"] = cookies_str
    body = None
    if data is not None:
        if isinstance(data, (dict, list)):
            body = json.dumps(data).encode("utf-8")
            if "Content-Type" not in hdrs:
                hdrs["Content-Type"] = "application/json;charset=UTF-8"
        elif isinstance(data, str):
            body = data.encode("utf-8")
        else:
            body = data

    req = urllib.request.Request(url, data=body, headers=hdrs, method=method)
    ctx = _ssl_context()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=timeout) as resp:
            content = resp.read()
            return resp.status, resp.headers, content
    except urllib.error.HTTPError as e:
        body = e.read()
        return e.code, e.headers, body
    except urllib.error.URLError as e:
        raise Net(f"cannot connect to {url}: {e.reason}")
    except OSError as e:
        raise Net(f"network error on {url}: {e}")


# -------------------------------------------------------- Search
def search_momo(query, sort="relevance", page=1, limit=20, min_price=None, max_price=None, via="auto"):
    sort_code = SORTS.get(sort, 1)
    q_enc = urllib.parse.quote(query)
    params = [f"_isFuzzy=0", f"searchType={sort_code}", f"curPage={page}"]
    if min_price is not None:
        params.append(f"priceS={int(min_price)}")
    if max_price is not None:
        params.append(f"priceE={int(max_price)}")
    url = f"{ORIGIN}/search/{q_enc}?" + "&".join(params)

    html = None
    if via in ("auto", "http"):
        try:
            status, hdrs, content = _request("GET", url, headers={"Referer": ORIGIN + "/"})
            if status == 200:
                html = content.decode("utf-8", errors="replace")
            elif status == 403:
                if via == "http":
                    raise Blocked(f"momo search returned 403 bot-wall")
        except Net:
            if via == "http":
                raise

    if html is None and via in ("auto", "browser"):
        with Browser(url=url) as b:
            time.sleep(2)
            html = b.eval("document.documentElement.outerHTML")

    if not html:
        raise Net("failed to fetch momo search page")

    # Extract ItemList from application/ld+json
    items = []
    scripts = re.findall(r'<script[^>]*type=[\'\"]application/ld\+json[\'\"][^>]*>(.*?)</script>', html, re.DOTALL)
    for s in scripts:
        try:
            data = json.loads(s)
            graph = data.get("@graph", [])
            for node in graph:
                if node.get("@type") == "ItemList":
                    for it in node.get("itemListElement", []):
                        purl = it.get("url", "")
                        icode_m = re.search(r"i_code=(\d+)", purl)
                        icode = icode_m.group(1) if icode_m else it.get("sku") or ""
                        offers = it.get("offers", {})
                        p_val = offers.get("price")
                        p_flt = float(p_val) if p_val is not None else None
                        rating_node = it.get("aggregateRating", {})
                        items.append({
                            "id": icode,
                            "title": it.get("name", "").strip(),
                            "price": p_flt,
                            "orig_price": None,
                            "discount": it.get("description", "").strip() or None,
                            "rating": float(rating_node["ratingValue"]) if "ratingValue" in rating_node else None,
                            "reviews": int(rating_node["reviewCount"]) if "reviewCount" in rating_node else None,
                            "stock": offers.get("availability") == "https://schema.org/InStock",
                            "url": f"{ORIGIN}/goods/GoodsDetail.jsp?i_code={icode}" if icode else purl,
                        })
        except Exception:
            continue

    # Extract original prices from RSC data if present
    rsc_chunks = re.findall(r'\"goodsCode\":\"(\d+)\".*?\"marketPriceModel\":\{\"basePrice\":\{.*?\"price\":\"([^\"]+)\"', html)
    orig_map = {}
    for gcode, pstr in rsc_chunks:
        try:
            orig_map[gcode] = float(pstr.replace(",", ""))
        except Exception:
            pass
    for it in items:
        if it["id"] in orig_map:
            it["orig_price"] = orig_map[it["id"]]

    # Filter min/max price if specified (guarantee precision)
    if min_price is not None:
        items = [it for it in items if it["price"] is not None and it["price"] >= min_price]
    if max_price is not None:
        items = [it for it in items if it["price"] is not None and it["price"] <= max_price]

    return items[:limit]


# -------------------------------------------------------- Product Detail
def product_id_from_arg(arg):
    arg = arg.strip()
    m = re.search(r"i_code=(\d+)", arg)
    if m:
        return m.group(1)
    m = re.search(r"/product/(\d+)", arg)
    if m:
        return m.group(1)
    if re.fullmatch(r"\d+", arg):
        return arg
    raise Usage(f"cannot extract momo product id from '{arg}' (expected digits or GoodsDetail.jsp?i_code=...)")


def product_detail(arg, via="auto"):
    pid = product_id_from_arg(arg)
    url = f"{ORIGIN}/goods/GoodsDetail.jsp?i_code={pid}"

    html = None
    if via in ("auto", "http"):
        try:
            status, hdrs, content = _request("GET", url, headers={"Referer": ORIGIN + "/"})
            if status == 200:
                html = content.decode("utf-8", errors="replace")
            elif status == 403 and via == "http":
                raise Blocked(f"product page returned 403")
        except Net:
            if via == "http":
                raise

    if html is None and via in ("auto", "browser"):
        with Browser(url=url) as b:
            time.sleep(2)
            html = b.eval("document.documentElement.outerHTML")

    if not html:
        raise Net(f"failed to fetch product {pid}")

    scripts = re.findall(r'<script[^>]*type=[\'\"]application/ld\+json[\'\"][^>]*>(.*?)</script>', html, re.DOTALL)
    prod_node = None
    for s in scripts:
        try:
            data = json.loads(s)
            for node in data.get("@graph", []):
                if node.get("@type") in ("ProductGroup", "Product"):
                    prod_node = node
                    break
        except Exception:
            continue

    if not prod_node:
        raise ApiError(f"product {pid} not found or structured data missing")

    brand = prod_node.get("brand", {}).get("name") if isinstance(prod_node.get("brand"), dict) else prod_node.get("brand")
    title = prod_node.get("name", "").strip()
    desc = prod_node.get("description", "").strip()

    variants = []
    shipping_label = None
    raw_vars = prod_node.get("hasVariant", [])
    if isinstance(raw_vars, list):
        for v in raw_vars:
            v_sku = str(v.get("sku") or "").strip()
            v_name = v.get("name", "").strip()
            v_offers = v.get("offers", {})
            v_price = float(v_offers.get("price")) if v_offers.get("price") is not None else None
            if not shipping_label and v_offers.get("shippingDetails"):
                sd = v_offers["shippingDetails"][0]
                shipping_label = sd.get("shippingLabel")
            variants.append({
                "id": v_sku,
                "name": v_name,
                "price": v_price,
                "in_stock": v_offers.get("availability") == "https://schema.org/InStock" or "availability" not in v_offers,
            })

    main_price = variants[0]["price"] if variants else None
    rating_node = prod_node.get("aggregateRating", {})

    return {
        "id": pid,
        "title": title,
        "brand": brand,
        "price": main_price,
        "orig_price": None,
        "promo": desc or None,
        "in_stock": any(v.get("in_stock", True) for v in variants) if variants else True,
        "shipping": shipping_label or "momo宅配",
        "rating": float(rating_node["ratingValue"]) if "ratingValue" in rating_node else None,
        "reviews": int(rating_node["reviewCount"]) if "reviewCount" in rating_node else None,
        "specs": variants,
        "url": url,
    }


# -------------------------------------------------------- Cart APIs
def _cart_headers(state):
    cookies_str = state.get("cookie") or ""
    storage = state.get("storage", {})
    token = storage.get("STORAGEINFO") or ""
    version = storage.get("VERSION") or ""
    return {
        "User-Agent": UA,
        "Referer": CART_URL,
        "Origin": CART_HOST,
        "Content-Type": "application/json;charset=UTF-8",
        "Authorization": f"Bearer {token}",
        "VERSION": version,
        "device": "4",
        "pf": "1",
    }, cookies_str


def get_cart_counts(state):
    headers, cookies_str = _cart_headers(state)
    url = f"{CART_HOST}/api/shoppingcart/query/getEachCartPICount"
    payload = {"host": "WEB"}
    status, _, body = _request("POST", url, data=payload, headers=headers, cookies_str=cookies_str)
    if status == 403:
        raise Auth("cart session expired or unauthenticated (HTTP 403). Run `momo login`.")
    try:
        res = json.loads(body.decode("utf-8"))
    except Exception as e:
        raise ApiError(f"invalid JSON from cart count API: {e}")
    if res.get("resultCode") != "1":
        raise Auth(f"momo returned error {res.get('resultCode')}: {res.get('resultMessage')}")
    return res


def get_cart_data(state):
    headers, cookies_str = _cart_headers(state)
    url = f"{CART_HOST}/api/shoppingcart/query/cartPageData"
    payload = {
        "data": {
            "cartName": "newNormal",
            "productStatus": [],
            "cartFlag": "2",
            "moProGoodsCode": "",
        },
        "host": "WEB",
    }
    status, _, body = _request("POST", url, data=payload, headers=headers, cookies_str=cookies_str)
    if status == 403:
        raise Auth("cart session expired or unauthenticated (HTTP 403). Run `momo login`.")
    try:
        res = json.loads(body.decode("utf-8"))
    except Exception as e:
        raise ApiError(f"invalid JSON from cart data API: {e}")

    # If cart is empty, momo returns resultCode "CPV006"
    if res.get("resultCode") == "CPV006" or res.get("totalCarts") == 0:
        return {"items": [], "total": 0, "subtotal": 0, "freight": 0, "discount": 0}

    rtn = res.get("rtnData", {})
    cart = rtn.get("shopCart", {})
    tm_goods = cart.get("tmGoods", {})

    items = []
    line_no = 1
    for k, v in tm_goods.items():
        gcode = v.get("goodsCode")
        count = v.get("goodsCount", 0)
        # 1190537 is logistics fee item, skip from user items
        if gcode in ("1190537",) or count <= 0:
            continue
        p_price = float(v.get("goodsPrice") or 0)
        p_last = float(v.get("goodsLastAmt") or p_price)
        unit_price = p_price / count if count > 0 else p_price
        p_keys = v.get("productKeys") or ([v.get("productKey")] if v.get("productKey") else [])
        p_ids = v.get("productIds") or ([v.get("productId")] if v.get("productId") else [])
        items.append({
            "line": line_no,
            "id": gcode,
            "name": v.get("goodsName"),
            "spec": v.get("goodsdtShowInfo") or v.get("goodsdtName") or v.get("goodsdtCode") or "單一規格",
            "dtCode": v.get("goodsdtCode") or "001",
            "qty": int(count),
            "unit_price": unit_price,
            "subtotal": p_price,
            "last_subtotal": p_last,
            "productKey": v.get("productKey"),
            "productKeys": p_keys,
            "productId": v.get("productId"),
            "productIds": p_ids,
            "originCartName": v.get("originCartName") or "newNormal",
        })
        line_no += 1

    subtotal = sum(it["subtotal"] for it in items)
    freight = float(cart.get("freightLastAmt") or 0)
    discount = float(cart.get("totalDcAmt") or 0)
    total = float(cart.get("totalLastPrice") or (subtotal + freight - discount))

    return {
        "items": items,
        "total": total,
        "subtotal": subtotal,
        "freight": freight,
        "discount": discount,
    }


def cart_add(state, product_id, qty=1, spec=None):
    pdetail = product_detail(product_id)
    target_spec = None
    specs = pdetail.get("specs") or []
    if spec:
        spec_s = spec.strip().lower()
        for s in specs:
            if spec_s in (s["name"].lower(), s["id"].lower()):
                target_spec = s
                break
        if not target_spec:
            avail = ", ".join(f"{s['id']}:{s['name']}" for s in specs)
            raise Usage(f"spec '{spec}' not found for product {pdetail['id']} (available: {avail})")
    elif len(specs) == 1:
        target_spec = specs[0]
    elif len(specs) > 1:
        avail = ", ".join(f"{s['id']}:{s['name']}" for s in specs)
        raise Usage(f"product {pdetail['id']} has multiple specs ({avail}) — pick one with --spec <id|name>")
    else:
        target_spec = {"id": "001", "name": "單一規格", "price": pdetail["price"]}

    dt_code = target_spec.get("id") or "001"
    unit_price = target_spec.get("price") or pdetail["price"] or 0

    headers, cookies_str = _cart_headers(state)
    headers["Referer"] = ORIGIN + "/"
    url = f"{CART_HOST}/api/shoppingcart/modify/addGoods"
    payload = {
        "host": "WEB",
        "data": {
            "goShopCartYn": "1",
            "goods": [{
                "work": "shopcart",
                "goodsCode": str(pdetail["id"]),
                "goodsName": pdetail["title"],
                "goodsPrice": str(int(unit_price)),
                "goodsdtCode": dt_code,
                "goodsCount": str(int(qty)),
                "recoverYn": "0",
                "addtionalGoods": [],
                "setGoods": [],
                "nsGift": [],
                "applimitBuyYn": "0",
                "applimitBuyfsCode": "",
                "cn": "",
                "defDely": "",
                "limitBuy4MemberYn": "0",
                "limitBuyQty": "30",
                "negativeProfit": "",
                "promoNo": "",
                "savegetAmt": "",
                "canUseBuy1Get1FreeYn": "0",
                "largeMachineMounting": "0",
                "largeMachineMountingPromoNo": "",
            }],
            "webCategoryCode": "",
            "srcType": "00",
            "cycleTimes": "",
            "cycleFrequency": "",
            "cycleYn": "0",
            "oc": True,
            "reduceQty": True,
            "outPlanDate": "",
            "webArea": "",
            "webCid": "",
            "webCtype": "",
            "webOid": "",
            "whCode": "",
            "postalCode": "",
            "inputAddress": "",
            "receiverSeq": "",
            "needInsurance": False,
            "splitDeliveryFlag": False,
        },
    }

    status, _, body = _request("POST", url, data=payload, headers=headers, cookies_str=cookies_str)
    if status == 403:
        raise Auth("cart session expired. Run `momo login`.")
    try:
        res = json.loads(body.decode("utf-8"))
    except Exception as e:
        raise ApiError(f"invalid JSON from addGoods API: {e}")
    if res.get("resultCode") != "1":
        raise ApiError(f"failed to add product to cart: {res.get('resultMessage')}")

    # Re-read cart to confirm
    cdata = get_cart_data(state)
    matching = [it for it in cdata["items"] if it["id"] == str(pdetail["id"])]
    if not matching:
        raise ApiError("addGoods succeeded but item was not found in cart after verification")

    return {
        "added": {
            "id": pdetail["id"],
            "title": pdetail["title"],
            "spec": target_spec["name"],
            "dtCode": dt_code,
            "qty": qty,
            "price": unit_price,
        },
        "cart": cdata,
    }


def cart_rm(state, line_or_id):
    cdata = get_cart_data(state)
    target = None
    if str(line_or_id).isdigit():
        ln = int(line_or_id)
        for it in cdata["items"]:
            if it["line"] == ln:
                target = it
                break
    if not target:
        for it in cdata["items"]:
            if it["id"] == str(line_or_id):
                target = it
                break
    if not target:
        raise Usage(f"item '{line_or_id}' not found in cart (run `momo cart list`)")

    headers, cookies_str = _cart_headers(state)
    url = f"{CART_HOST}/api/shoppingcart/modify/removeGoods"
    payload = {
        "host": "WEB",
        "data": {
            "cartName": "newNormal",
            "productKey": target["productKey"],
            "productStatus": "0",
            "productKeyList": target["productKeys"],
        },
    }

    status, _, body = _request("POST", url, data=payload, headers=headers, cookies_str=cookies_str)
    if status == 403:
        raise Auth("cart session expired. Run `momo login`.")
    try:
        res = json.loads(body.decode("utf-8"))
    except Exception as e:
        raise ApiError(f"invalid JSON from removeGoods API: {e}")
    if res.get("resultCode") != "1":
        raise ApiError(f"failed to remove goods: {res.get('resultMessage')}")

    # Re-read cart to confirm
    cdata_new = get_cart_data(state)
    still_there = any(it["id"] == target["id"] for it in cdata_new["items"])
    if still_there:
        raise ApiError(f"removeGoods succeeded but product {target['id']} is still in cart")

    return {
        "removed": target,
        "cart": cdata_new,
    }


def cart_qty(state, line_or_id, qty):
    cdata = get_cart_data(state)
    target = None
    if str(line_or_id).isdigit():
        ln = int(line_or_id)
        for it in cdata["items"]:
            if it["line"] == ln:
                target = it
                break
    if not target:
        for it in cdata["items"]:
            if it["id"] == str(line_or_id):
                target = it
                break
    if not target:
        raise Usage(f"item '{line_or_id}' not found in cart (run `momo cart list`)")

    if target["qty"] == qty:
        return {"updated": target, "cart": cdata, "message": "quantity already matches"}

    headers, cookies_str = _cart_headers(state)
    url = f"{CART_HOST}/api/shoppingcart/modify/changeGoodsCount"
    payload = {
        "host": "WEB",
        "data": {
            "cartName": "newNormal",
            "productId": target["productId"],
            "productIdList": target["productIds"],
            "productKey": target["productKey"],
            "productKeyList": target["productKeys"],
            "goodsCode": target["id"],
            "goodsCount": int(qty),
        },
    }

    status, _, body = _request("POST", url, data=payload, headers=headers, cookies_str=cookies_str)
    if status == 403:
        raise Auth("cart session expired. Run `momo login`.")
    try:
        res = json.loads(body.decode("utf-8"))
    except Exception as e:
        raise ApiError(f"invalid JSON from changeGoodsCount API: {e}")
    if res.get("resultCode") != "1":
        raise ApiError(f"failed to change quantity: {res.get('resultMessage')}")

    # Re-read cart to confirm
    cdata_new = get_cart_data(state)
    matching = [it for it in cdata_new["items"] if it["id"] == target["id"]]
    if not matching or matching[0]["qty"] != int(qty):
        actual = matching[0]["qty"] if matching else 0
        raise ApiError(f"changeGoodsCount succeeded but quantity is {actual}, expected {qty}")

    return {
        "updated": matching[0],
        "cart": cdata_new,
    }


# -------------------------------------------------------- Login & Whoami
def login_from_browser(wait_seconds=300, keyring=False):
    cks, ua = edge_cookies()
    cookie_dict = {c["name"]: c["value"] for c in cks}

    # Check if signed in
    is_signed_in = (
        cookie_dict.get("loginRsult") == "1"
        or cookie_dict.get("customer") == "1"
        or "loginUser" in cookie_dict
    )

    tid = None
    if not is_signed_in:
        print(f"Edge is not logged into momo. Opening background tab to login page...", file=sys.stderr)
        ver = _cdp_json("/json/version")
        b_ws = WS(ver["webSocketDebuggerUrl"])
        try:
            target = b_ws.call("Target.createTarget", url=LOGIN_URL, background=True)
            tid = target["targetId"]
            print(f"Please sign in to momo in Edge. Waiting up to {wait_seconds}s...", file=sys.stderr)
            t0 = time.time()
            while time.time() - t0 < wait_seconds:
                time.sleep(3)
                cks, _ = edge_cookies()
                cd = {c["name"]: c["value"] for c in cks}
                if cd.get("loginRsult") == "1" or cd.get("customer") == "1" or "loginUser" in cd:
                    is_signed_in = True
                    break
        finally:
            if tid:
                try:
                    b_ws.call("Target.closeTarget", targetId=tid)
                except Exception:
                    pass
            b_ws.close()

    if not is_signed_in:
        raise Auth(f"not logged into momo in Edge after waiting {wait_seconds}s")

    # Fetch STORAGEINFO and VERSION from cart page
    storage = {}
    ver = _cdp_json("/json/version")
    b_ws = WS(ver["webSocketDebuggerUrl"])
    bg_tid = None
    try:
        # Check if an existing tab already has cart
        tabs = _cdp_json("/json/list")
        cart_tabs = [t for t in tabs if "cart.momoshop.com.tw" in t.get("url", "")]
        tab_ws = None
        if cart_tabs:
            tab_ws = WS(cart_tabs[0]["webSocketDebuggerUrl"])
        else:
            bg_target = b_ws.call("Target.createTarget", url=CART_URL, background=True)
            bg_tid = bg_target["targetId"]
            tabs = _cdp_json("/json/list")
            tgt = next(t for t in tabs if t["id"] == bg_tid)
            tab_ws = WS(tgt["webSocketDebuggerUrl"])
            time.sleep(2)

        for _ in range(25):
            res = tab_ws.call("Runtime.evaluate", expression="""
            ({
                STORAGEINFO: localStorage.getItem('STORAGEINFO'),
                VERSION: localStorage.getItem('VERSION')
            })
            """, returnByValue=True)
            val = res.get("result", {}).get("value", {})
            if val.get("STORAGEINFO") and val.get("VERSION"):
                storage = val
                break
            time.sleep(0.5)
        tab_ws.close()
    finally:
        if bg_tid:
            try:
                b_ws.call("Target.closeTarget", targetId=bg_tid)
            except Exception:
                pass
        b_ws.close()

    cookie_hdr = cookie_list_to_header(cks)
    st = {
        "cookies": cks,
        "cookie": cookie_hdr,
        "storage": storage,
        "cookie_in_keyring": keyring,
        "saved_at": int(time.time()),
    }

    # Verify session via plain HTTP
    vres = get_cart_counts(st)
    cust_no = vres.get("custNo") or cookie_dict.get("cn") or ""
    masked_name = urllib.parse.unquote(cookie_dict.get("loginUser", "")).strip()

    # Base64 decode ck_mlu for member ID
    ck_mlu = cookie_dict.get("ck_mlu", "")
    member_id = ""
    if ck_mlu:
        try:
            member_id = base64.b64decode(ck_mlu.strip('"')).decode("utf-8", errors="replace")
        except Exception:
            member_id = ck_mlu

    st["user"] = {
        "custNo": cust_no,
        "memberId": member_id,
        "loginUser": masked_name,
        "couponNumber": cookie_dict.get("couponNumber", "0"),
        "wishlistNumber": cookie_dict.get("WishListNumber", "0"),
    }

    save_state(st)
    return st


