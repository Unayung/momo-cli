def whoami_data(state):
    if not state.get("cookie"):
        raise Auth("not logged in. Run `momo login`.")
    counts = get_cart_counts(state)
    u = state.get("user") or {}
    total_cart_items = 0
    for c in counts.get("rtnData", {}).get("rtnData", []):
        total_cart_items += c.get("totalCount", 0)

    return {
        "custNo": counts.get("custNo") or u.get("custNo"),
        "memberId": u.get("memberId"),
        "loginUser": u.get("loginUser"),
        "coupons": u.get("couponNumber"),
        "wishlist": u.get("wishlistNumber"),
        "cartItems": total_cart_items,
        "sessionSource": state.get("source", "file"),
    }


# -------------------------------------------------------- Doctor
def run_doctor():
    report = {"http": False, "browser": False, "login": False, "cart": False, "details": {}}
    # 1. HTTP transport
    try:
        st, _, body = _request("GET", ORIGIN + "/")
        report["http"] = st == 200
        report["details"]["http_status"] = st
    except Exception as e:
        report["details"]["http_error"] = str(e)

    # 2. Browser CDP
    try:
        v = _cdp_json("/json/version")
        report["browser"] = True
        report["details"]["browser"] = v.get("Browser")
    except Exception as e:
        report["details"]["browser_error"] = str(e)

    # 3. Login & Cart
    st = load_state()
    if st.get("cookie"):
        try:
            who = whoami_data(st)
            report["login"] = True
            report["cart"] = True
            report["details"]["user"] = who
        except Exception as e:
            report["details"]["auth_error"] = str(e)

    return report


