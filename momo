        cmd = ["pbpaste"] if sys.platform == "darwin" else ["wl-paste"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=True)
            cookie_str = res.stdout
        except Exception:
            try:
                res = subprocess.run(["xclip", "-selection", "clipboard", "-o"], capture_output=True, text=True, check=True)
                cookie_str = res.stdout
            except Exception:
                raise Usage("could not read clipboard (install wl-paste or xclip)")
        st = login_from_cookie(cookie_str, keyring=args.keyring)
    else:
        st = login_from_browser(wait_seconds=args.wait, keyring=args.keyring)

    who = whoami_data(st)
    def h():
        return f"Logged in successfully as {who['loginUser']} (custNo: {who['custNo']}, memberId: {who['memberId']})"
    return emit(ok(who), args.json, h)


def cmd_whoami(args):
    st = load_state()
    who = whoami_data(st)
    def h():
        return "\n".join([
            f"Member Name:  {who['loginUser']}",
            f"Member ID:    {who['memberId']}",
            f"Cust No:      {who['custNo']}",
            f"Coupons:      {who['coupons']}",
            f"Wishlist:     {who['wishlist']}",
            f"Cart Items:   {who['cartItems']}",
            f"Source:       {who['sessionSource']}",
        ])
    return emit(ok(who), args.json, h)


def cmd_logout(args):
    clear_state()
    return emit(ok({"message": "Logged out successfully"}), args.json, "Logged out successfully.")


def cmd_cart(args):
    st = load_state()
    if not st.get("cookie"):
        raise Auth("cart commands require login. Run `momo login`.")

    action = args.action
    if not action or action == "list":
        cdata = get_cart_data(st)
        def h():
            items = cdata["items"]
            if not items:
                return "Your momo shopping cart is empty."
            rows = []
            for it in items:
                rows.append([
                    str(it["line"]),
                    it["id"],
                    clip(it["name"], 38),
                    clip(it["spec"], 12),
                    str(it["qty"]),
                    nt(it["unit_price"]),
                    nt(it["subtotal"]),
                ])
            tbl = table(rows, ["Line", "ID", "Name", "Spec", "Qty", "Price", "Subtotal"])
            summary = [
                f"\nTotal Items:  {len(items)}",
                f"Subtotal:     {nt(cdata['subtotal'])}",
                f"Shipping:     {nt(cdata['freight'])}",
                f"Discount:    -{nt(cdata['discount'])}",
                f"Total:        {nt(cdata['total'])}",
            ]
            return tbl + "\n" + "\n".join(summary)
        return emit(ok(cdata), args.json, h)

    elif action == "add":
        if not args.ref:
            raise Usage("cart add needs a product id or URL")
        if not args.yes:
            pd = product_detail(args.ref, via=args.via)
            specs = pd.get("specs") or []
            chosen_spec = None
            if args.spec:
                for s in specs:
                    if args.spec.strip().lower() in (s["name"].lower(), s["id"].lower()):
                        chosen_spec = s
                        break
            elif len(specs) == 1:
                chosen_spec = specs[0]
            dry = {
                "dry_run": True,
                "action": "add",
                "id": pd["id"],
                "title": pd["title"],
                "spec": chosen_spec["name"] if chosen_spec else (args.spec or "default"),
                "qty": args.qty,
                "price": chosen_spec["price"] if chosen_spec else pd["price"],
                "subtotal": (chosen_spec["price"] if chosen_spec else pd["price"] or 0) * args.qty,
            }
            def h():
                return (f"DRY RUN (pass --yes to execute):\n"
                        f"Would add {dry['qty']}x '{dry['title']}' ({dry['spec']}) at {nt(dry['price'])} each.")
            return emit(ok(dry), args.json, h)

        res = cart_add(st, args.ref, qty=args.qty, spec=args.spec)
        def h():
            it = res["added"]
            return f"Added to cart: {it['qty']}x '{it['title']}' ({it['spec']}) - {nt(it['price'])} each."
        return emit(ok(res), args.json, h)

    elif action == "rm":
        if not args.ref:
            raise Usage("cart rm needs a line # or product id")
        if not args.yes:
            cdata = get_cart_data(st)
            target = None
            if str(args.ref).isdigit() and len(args.ref) < 4:
                ln = int(args.ref)
                for it in cdata["items"]:
                    if it["line"] == ln: target = it; break
            if not target:
                for it in cdata["items"]:
                    if it["id"] == str(args.ref): target = it; break
            dry = {
                "dry_run": True,
                "action": "remove",
                "target": target or {"query": args.ref},
            }
            def h():
                if target:
                    return f"DRY RUN (pass --yes to execute):\nWould remove '{target['name']}' (Line {target['line']}, ID {target['id']}) from cart."
                return f"DRY RUN: item '{args.ref}' not found in cart."
            return emit(ok(dry), args.json, h)

        res = cart_rm(st, args.ref)
        def h():
            r = res["removed"]
            return f"Removed from cart: '{r['name']}' (Line {r['line']}, ID {r['id']})."
        return emit(ok(res), args.json, h)

    elif action == "qty":
        if not args.ref:
            raise Usage("cart qty needs a line # or product id")
        new_qty = args.n if args.n is not None else args.qty
        if not args.yes:
            cdata = get_cart_data(st)
            target = None
            if str(args.ref).isdigit() and len(args.ref) < 4:
                ln = int(args.ref)
                for it in cdata["items"]:
                    if it["line"] == ln: target = it; break
            if not target:
                for it in cdata["items"]:
                    if it["id"] == str(args.ref): target = it; break
            dry = {
                "dry_run": True,
                "action": "qty",
                "target": target or {"query": args.ref},
                "new_qty": new_qty,
            }
            def h():
                if target:
                    return f"DRY RUN (pass --yes to execute):\nWould set qty of '{target['name']}' from {target['qty']} to {new_qty}."
                return f"DRY RUN: item '{args.ref}' not found in cart."
            return emit(ok(dry), args.json, h)

        res = cart_qty(st, args.ref, new_qty)
        def h():
            u = res["updated"]
            return f"Updated qty: '{u['name']}' is now {u['qty']}x."
        return emit(ok(res), args.json, h)

    raise Usage(f"unknown cart action '{action}'")


# -------------------------------------------------------- Parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def build_parser():
    p = Parser(prog="momo", description="momo購物網 from the shell (no checkout).")
    p.add_argument("--version", action="version", version=f"momo {VERSION}")

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="output JSON envelope {ok, data|error}")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="transport: auto, http, browser (default: auto)")
    common.add_argument("--cdp", default=None, help=f"CDP browser URL (default: {CDP})")

    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="API reachability, browser, login + cart state"
                   ).set_defaults(fn=cmd_doctor)

    s = sub.add_parser("search", parents=[common], help="search products")
    s.add_argument("query", help="search keyword")
    s.add_argument("--limit", type=int, default=20, help="max results (default: 20)")
    s.add_argument("--sort", choices=list(SORTS.keys()), default="relevance",
                   help="sort order (default: relevance)")
    s.add_argument("--page", type=int, default=1, help="page number (default: 1)")
    s.add_argument("--min", type=float, dest="min_price", help="minimum price TWD")
    s.add_argument("--max", type=float, dest="max_price", help="maximum price TWD")
    s.set_defaults(fn=cmd_search)

    pr = sub.add_parser("product", aliases=["item"], parents=[common],
                        help="product details with specs/variants")
    pr.add_argument("product", help="product id or GoodsDetail.jsp URL")
    pr.set_defaults(fn=cmd_product)

    pc = sub.add_parser("price", parents=[common], help="quick batch price check")
    pc.add_argument("products", nargs="+", help="one or more product ids or URLs")
    pc.set_defaults(fn=cmd_price)

    r = sub.add_parser("raw", parents=[common], help="GET a read-only momo JSON endpoint")
    r.add_argument("path", help="path or full URL")
    r.set_defaults(fn=cmd_raw)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in momo session")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true", default=True,
                   help="(default) copy session from Edge CDP")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe Cookie header")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for login (default: 300)")
    lg.add_argument("--keyring", action="store_true", help="store session in OS keyring")
    lg.set_defaults(fn=cmd_login)

    sub.add_parser("whoami", parents=[common], help="verify and show member account status"
                   ).set_defaults(fn=cmd_whoami)
    sub.add_parser("logout", parents=[common], help="forget saved session"
                   ).set_defaults(fn=cmd_logout)

    ct = sub.add_parser("cart", parents=[common], help="購物車: list / add / rm / qty (no checkout)")
    ct.add_argument("action", nargs="?", default="list", choices=["list", "add", "rm", "qty"])
    ct.add_argument("ref", nargs="?", help="add: product id/URL; rm/qty: line # or product id")
    ct.add_argument("n", nargs="?", type=int, help="qty: new quantity")
    ct.add_argument("--qty", type=int, default=1, help="quantity (default 1)")
    ct.add_argument("--spec", "--opt", dest="spec", help="variant name or sku id")
    ct.add_argument("--yes", action="store_true", help="really execute write (else dry run)")
    ct.set_defaults(fn=cmd_cart)

    return p


def main(argv=None):
    p = build_parser()
    args = p.parse_args(argv)
    if getattr(args, "cdp", None):
        _set_cdp(args.cdp)

    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE, **(e.detail or {})), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
